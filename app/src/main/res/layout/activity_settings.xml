<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/dark_bg_toolbar"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBackSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/dark_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textColor="@color/dark_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dark_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Theme -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="@color/dark_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dark Mode"
                    android:textColor="@color/dark_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_border"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Editor -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editor"
                android:textColor="@color/dark_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Font Size"
                    android:textColor="@color/dark_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvFontSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13sp"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="5"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Word Wrap"
                    android:textColor="@color/dark_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchWordWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto Complete"
                    android:textColor="@color/dark_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoComplete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_border"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- SDK -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SDK Management"
                android:textColor="@color/dark_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadSdks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download/Update SDK Components"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSdkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SDK Status: Not initialized"
                android:textColor="@color/dark_text_secondary"
                android:textSize="12sp"
                android:padding="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_border"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Build -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Build Configuration"
                android:textColor="@color/dark_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JDK Version"
                android:textColor="@color/dark_text_primary"
                android:textSize="15sp"
                android:padding="12dp" />

            <RadioGroup
                android:id="@+id/rgJdkVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp">

                <RadioButton
                    android:id="@+id/rbJdk17"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JDK 17"
                    android:textColor="@color/dark_text_primary"
                    android:buttonTint="@color/dark_accent"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbJdk21"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JDK 21"
                    android:textColor="@color/dark_text_primary"
                    android:buttonTint="@color/dark_accent" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gradle Version"
                android:textColor="@color/dark_text_primary"
                android:textSize="15sp"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <RadioGroup
                android:id="@+id/rgGradleVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp">

                <RadioButton
                    android:id="@+id/rbGradle814"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradle 8.14.4"
                    android:textColor="@color/dark_text_primary"
                    android:buttonTint="@color/dark_accent"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbGradle930"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradle 9.3.0"
                    android:textColor="@color/dark_text_primary"
                    android:buttonTint="@color/dark_accent" />

                <RadioButton
                    android:id="@+id/rbGradle940"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradle 9.4.0"
                    android:textColor="@color/dark_text_primary"
                    android:buttonTint="@color/dark_accent" />
            </RadioGroup>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
